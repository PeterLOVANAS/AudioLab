# SQLite journals and private CLI output must never enter a source archive.
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
admin-credentials.json
labellers-private.json
access-token.json
*.cookies

# Personal editor preferences and local notes (not release inputs)
/.vscode/
/important.txt
/explainNote_agents.md
# Presentation/operator notes are retained locally pending privacy/rights review.
/DEMO_DOCS/
/IMPORTANT COMMAND/

# Only the two generated, CC0 release example recordings are distributable.
# Keep every other local/research WAV excluded.
!/examples/datasets/synthetic/audio/steady-tone.wav
!/examples/datasets/synthetic/audio/pulsed-tone.wav

# Redistribution is unresolved for these two historical benchmark examples.
# They remain on disk; already tracked/history copies require a maintainer decision.
/docs/examples/mmau-one-sample.json
/docs/examples/mmau-one-sample-stored.json
