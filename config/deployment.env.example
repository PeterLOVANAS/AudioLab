# Copy outside the repository, chmod 600, fill, then explicitly export/source.
# No VITE_ prefix: these values are Worker/operator configuration, not client env.
AUDIOLAB_ENV=staging
AUDIOLAB_AUTH_MODE=access
AUDIOLAB_HOST_MODE=custom-domain
AUDIOLAB_WORKER_NAME=replace-with-staging-worker-name
APP_ORIGIN=https://replace-with-canonical-host.example
ACCESS_TEAM_DOMAIN=https://replace-with-team.cloudflareaccess.com
ACCESS_AUDIENCE=replace-with-application-aud-tag
AUDIOLAB_D1_ID=replace-with-created-database-uuid
AUDIOLAB_D1_NAME=replace-with-created-database-name
AUDIOLAB_R2_BUCKET=replace-with-private-bucket-name
# Optional STAGING ONLY, instead of custom-domain mode; no zone purchase needed.
# AUDIOLAB_HOST_MODE=workers-dev
# AUDIOLAB_WORKERS_SUBDOMAIN=replace-with-account-workers-subdomain
# APP_ORIGIN=https://WORKER_NAME.ACCOUNT_SUBDOMAIN.workers.dev
# Set only after verifying this exact Worker's Access > All traffic policy,
# explicit Allow roster, application AUD/issuer, cookies and no Bypass overrides.
# This is an operator confirmation, not an automated cloud policy check.
# AUDIOLAB_WORKERS_DEV_ACCESS_CONFIRMED=true
# Cloud API authentication is operator-only, separate from Access user tokens.
# Configure CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN through a private
# operator environment/approved cf profile. They are NOT Worker bindings.
